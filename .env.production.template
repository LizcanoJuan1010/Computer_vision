# VIGIAS-IA - Production Environment Variables
# Version: 1.3.0 + Sprint 1 Complete
# Date: 2025-12-29
#
# INSTRUCCIONES:
# 1. Copiar este archivo a .env
# 2. Cambiar TODOS los passwords marcados con <CAMBIAR>
# 3. Ajustar IPs y puertos según infraestructura del cliente
# 4. NO commitear el archivo .env a git

# ============================================
# GENERAL
# ============================================
TZ=America/Bogota
ENVIRONMENT=production

# ============================================
# DATABASE (PostgreSQL + pgvector)
# ============================================
DB_USER=vigias_prod_user
DB_PASSWORD=<CAMBIAR_PASSWORD_SEGURO_MINIMO_16_CARACTERES>
DB_NAME=vigias_production

# External ports (si se exponen)
VISION_DB_PORT=5432

# ============================================
# HIKVISION DVR/NVR
# ============================================
# Credenciales del sistema de cámaras
HIK_USER=admin
HIK_PASS=<CAMBIAR_PASSWORD_DVR>

# IP del NVR/DVR
HIK_IP=192.168.1.64

# Puertos
PORT_RTSP=554
PORT_HTTP=8080

# Transporte (tcp recomendado para producción)
RTSP_TRANSPORT=tcp

# ============================================
# FACE RECOGNITION CACHE
# ============================================
# Habilitar cache (RECOMENDADO para producción)
FACE_CACHE_ENABLED=true

# Capacidad L1 (memoria RAM)
# 1000 = ~512KB por rostro x 1000 = 512MB RAM
# Ajustar según RAM disponible:
# - 16GB RAM: 1000 rostros
# - 32GB RAM: 2000-3000 rostros
# - 64GB RAM: 5000+ rostros
FACE_CACHE_L1_CAPACITY=1000

# Threshold de similaridad (0.0-1.0)
# 0.85 = Estricto (recomendado para zonas restringidas)
# 0.75 = Medio (balance precision/recall)
# 0.65 = Tolerante (más false positives)
SIMILARITY_THRESHOLD=0.85

# ============================================
# NVIDIA GPU
# ============================================
# Habilitar todas las GPUs disponibles
NVIDIA_VISIBLE_DEVICES=all

# Capabilities necesarias
NVIDIA_DRIVER_CAPABILITIES=compute,utility

# ============================================
# REDIS (Cache L2)
# ============================================
REDIS_PORT=6379

# Password de Redis (opcional pero recomendado en producción)
REDIS_PASSWORD=<CAMBIAR_REDIS_PASSWORD>

# ============================================
# NATS (Message Broker)
# ============================================
NATS_PORT=4222

# Cluster mode (opcional, para alta disponibilidad)
# NATS_CLUSTER=nats://nats-1:6222,nats://nats-2:6222

# ============================================
# API SERVICES
# ============================================
# Router API (FastAPI)
ROUTER_PORT=8003

# Inference Service
INFERENCE_PORT=5000

# Ingest Service (Metrics)
INGEST_PORT=8081

# ============================================
# SECURITY
# ============================================
# JWT Secret (para autenticación API)
JWT_SECRET=<CAMBIAR_JWT_SECRET_RANDOM_64_CARACTERES>

# API Rate Limiting (requests por minuto)
API_RATE_LIMIT=100

# CORS Allowed Origins (separados por coma)
CORS_ORIGINS=https://vigias.cliente.com,https://app.cliente.com

# ============================================
# MONITORING (Opcional)
# ============================================
# Prometheus
# PROMETHEUS_ENABLED=true
# PROMETHEUS_PORT=9090

# Grafana
# GRAFANA_ENABLED=true
# GRAFANA_PORT=3000
# GRAFANA_ADMIN_PASSWORD=<CAMBIAR_GRAFANA_PASSWORD>

# ============================================
# BACKUPS
# ============================================
# Directorio de backups (host)
BACKUP_DIR=/backup/vigias-ia

# Retención de backups (días)
BACKUP_RETENTION_DAYS=30

# Hora de backup diario (formato cron)
BACKUP_CRON_SCHEDULE=0 2 * * *

# ============================================
# LOGGING
# ============================================
# Nivel de log (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Directorio de logs (host)
LOG_DIR=/var/log/vigias-ia

# Rotación de logs (días)
LOG_RETENTION_DAYS=30

# ============================================
# PERFORMANCE TUNING
# ============================================
# Inference batch size
INFERENCE_BATCH_SIZE=4

# YOLO confidence threshold
YOLO_CONFIDENCE=0.5

# Face detection confidence
FACE_DETECTION_CONFIDENCE=0.7

# FPS target para streams
TARGET_FPS=15

# Resize resolution (ancho x alto)
RESIZE_WIDTH=640
RESIZE_HEIGHT=360

# ============================================
# DOCKER RESOURCE LIMITS
# ============================================
# Inference Service
INFERENCE_MEMORY_LIMIT=8G
INFERENCE_CPU_LIMIT=4

# Router API
ROUTER_MEMORY_LIMIT=2G
ROUTER_CPU_LIMIT=2

# PostgreSQL
POSTGRES_MEMORY_LIMIT=4G
POSTGRES_CPU_LIMIT=2

# Redis
REDIS_MEMORY_LIMIT=2G
REDIS_CPU_LIMIT=1

# ============================================
# CLIENT SPECIFIC
# ============================================
# Nombre del cliente (slug)
CLIENT_SLUG=cliente-demo

# Nombre del cliente (display)
CLIENT_NAME=Cliente Demo S.A.

# Contact email para alertas
CLIENT_EMAIL=alertas@cliente.com

# Webhook URL para notificaciones externas (opcional)
# WEBHOOK_URL=https://hooks.slack.com/services/...

# ============================================
# FEATURE FLAGS
# ============================================
# Auto-save unknown faces en zonas restringidas
AUTO_SAVE_UNKNOWN=true

# Global blacklist habilitado
GLOBAL_BLACKLIST_ENABLED=true

# Temporary whitelists habilitado
TEMPORARY_WHITELISTS_ENABLED=true

# Streaming MJPEG habilitado
STREAMING_ENABLED=true

# ============================================
# NETWORK
# ============================================
# Docker network name
DOCKER_NETWORK=vision_net

# External domain (para reverse proxy)
EXTERNAL_DOMAIN=vigias.cliente.com

# SSL habilitado
SSL_ENABLED=true

# ============================================
# DATOS DE EJEMPLO (Solo desarrollo)
# ============================================
# SEED_DATABASE=false

# ============================================
# FIN DE CONFIGURACIÓN
# ============================================
